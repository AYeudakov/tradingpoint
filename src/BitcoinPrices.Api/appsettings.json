{
  "ConnectionStrings": {
    "Prices": "Data Source=bitcoin-prices.db"
  },
  "PriceProviders": {
    "Bitstamp": {
      "BaseUrl": "https://www.bitstamp.net/",
      "TimeoutSeconds": 10
    },
    "Bitfinex": {
      "BaseUrl": "https://api-pub.bitfinex.com/",
      "TimeoutSeconds": 10
    }
  },
  "Aggregation": {
    "MinimumSuccessfulProviders": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
